pkgname=hum
pkgver=0.1.0
pkgrel=1
pkgdesc='Music player with a visualizer, for Omarchy'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-wayland' 'ffmpeg')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/hum "$pkgdir/usr/bin/hum"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/hum.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/hum.svg"
  install -Dm644 "$startdir/hum.desktop" "$pkgdir/usr/share/applications/hum.desktop"
}
